#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SERVICE_NAME="inframatik"

echo ""
echo "  inframatik setup"
echo ""

# --- Prerequisites ---
for cmd in python3 curl sudo; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "ERROR: $cmd is required but not installed."
        exit 1
    fi
done

if [ "$(id -u)" -eq 0 ]; then
    echo "ERROR: Do not run as root. Run as a regular user with sudo access."
    exit 1
fi

# --- Admin password ---
ADMIN_PW=""
while true; do
    read -sp "Set admin password (min 8 chars): " ADMIN_PW
    echo
    if [ ${#ADMIN_PW} -lt 8 ]; then
        echo "  Password too short."
        ADMIN_PW=""
        continue
    fi
    read -sp "Confirm password: " ADMIN_PW_CONFIRM
    echo
    if [ "$ADMIN_PW" != "$ADMIN_PW_CONFIRM" ]; then
        echo "  Passwords do not match."
        ADMIN_PW=""
        continue
    fi
    unset ADMIN_PW_CONFIRM
    break
done

# --- Python environment ---
echo ""
echo "==> Setting up Python environment..."
if [ ! -d "$REPO_DIR/venv" ]; then
    python3 -m venv "$REPO_DIR/venv"
fi
"$REPO_DIR/venv/bin/pip" install -q -r "$REPO_DIR/requirements.txt"
echo "    Dependencies installed"

# --- Systemd user service ---
echo "==> Creating systemd service..."
mkdir -p "$HOME/.config/systemd/user"
cat > "$HOME/.config/systemd/user/${SERVICE_NAME}.service" << EOF
[Unit]
Description=inframatik
After=network-online.target

[Service]
Type=simple
WorkingDirectory=${REPO_DIR}
ExecStart=${REPO_DIR}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 9000
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
EOF

# --- Enable linger ---
if ! loginctl show-user "$(whoami)" 2>/dev/null | grep -q "Linger=yes"; then
    echo "==> Enabling linger (requires sudo)..."
    sudo loginctl enable-linger "$(whoami)"
fi

# --- Start service ---
systemctl --user daemon-reload
systemctl --user enable --now "$SERVICE_NAME"
echo "==> Service started"

# --- Wait for server ---
echo -n "    Waiting for server"
SERVER_READY=false
for i in $(seq 1 20); do
    if curl -sS -o /dev/null -w "" "http://127.0.0.1:9000/api/auth/status" 2>/dev/null; then
        echo " ready"
        SERVER_READY=true
        break
    fi
    echo -n "."
    sleep 1
done

if [ "$SERVER_READY" = false ]; then
    echo " timeout"
    echo "ERROR: Server did not start. Check: systemctl --user status inframatik"
    unset ADMIN_PW
    exit 1
fi

# --- Set admin password (piped via stdin to avoid process arg exposure) ---
python3 -c "
import json, sys, urllib.request, urllib.error
pw = sys.stdin.readline().strip()
body = json.dumps({'password': pw}).encode()
req = urllib.request.Request(
    'http://127.0.0.1:9000/api/auth/set-password',
    data=body,
    headers={'Content-Type': 'application/json'},
    method='POST',
)
try:
    with urllib.request.urlopen(req) as resp:
        result = json.loads(resp.read())
        if result.get('status') == 'password_set':
            print('==> Admin password set')
        else:
            print('WARNING: Unexpected response:', result)
except urllib.error.HTTPError as e:
    detail = ''
    try:
        detail = json.loads(e.read()).get('detail', '')
    except Exception:
        pass
    if e.code == 400 and 'already set' in detail.lower():
        print('==> Password already set (re-run detected)')
    else:
        print(f'WARNING: Failed to set password (HTTP {e.code}): {detail}')
        print('    Set it in the browser at http://localhost:9000')
" <<< "$ADMIN_PW"
unset ADMIN_PW

# --- Install CLI ---
echo "==> Installing CLI..."
chmod +x "$REPO_DIR/inframatik-cli.py"
mkdir -p "$HOME/.local/bin"
ln -sf "$REPO_DIR/inframatik-cli.py" "$HOME/.local/bin/inframatik"
if ! echo "$PATH" | grep -q "$HOME/.local/bin"; then
    if ! grep -q '\.local/bin' "$HOME/.bashrc" 2>/dev/null; then
        echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
        echo "    Added ~/.local/bin to PATH (open new terminal to use 'inframatik' command)"
    fi
fi

# --- Ports env sourcing ---
if ! grep -q 'inframatik/ports.env' "$HOME/.bashrc" 2>/dev/null; then
    echo '' >> "$HOME/.bashrc"
    echo '# inframatik service ports' >> "$HOME/.bashrc"
    echo '[ -f ~/.config/inframatik/ports.env ] && source ~/.config/inframatik/ports.env' >> "$HOME/.bashrc"
fi

# --- Done ---
LOCAL_IP=$(python3 -c "
import socket
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect(('8.8.8.8', 1))
    print(s.getsockname()[0])
    s.close()
except Exception:
    print('localhost')
" 2>/dev/null)

echo ""
echo "  ✓ inframatik is running"
echo ""
echo "    Local:   http://localhost:9000"
echo "    Network: http://${LOCAL_IP}:9000"
echo ""
echo "    Log in with the password you just set."
echo "    Then choose a role: Standalone, Master, or Worker."
echo ""
